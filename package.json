{
  "name": "vidplot",
  "productName": "VidPlot",
  "desktopName": "VidPlot.desktop",
  "version": "1.2.0",
  "description": "Local video frame analyzer",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node electron/ensure-electron.js",
    "electron": "node electron/launch.js",
    "desktop": "node electron/launch.js",
    "dist": "node electron/check-sidecar.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.vidplot.app",
    "productName": "VidPlot",
    "asar": true,
    "forceCodeSigning": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/vidplot-server",
        "to": "vidplot-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mov",
          "m4v",
          "mkv",
          "avi",
          "ts",
          "m2ts",
          "mts",
          "webm",
          "h264",
          "h265",
          "hevc",
          "yuv",
          "raw",
          "y4m"
        ],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "static/icons/VidPlot.icns",
      "identity": "-",
      "target": [
        "zip"
      ],
      "artifactName": "VidPlot-macOS-${arch}.${ext}"
    },
    "win": {
      "icon": "static/icons/VidPlot.ico",
      "target": [
        "zip",
        "nsis"
      ],
      "artifactName": "VidPlot-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "VidPlot-Windows-${arch}-Setup.${ext}"
    },
    "linux": {
      "category": "Video",
      "syncDesktopName": true,
      "executableArgs": [
        "--no-sandbox"
      ],
      "icon": "static/icons/icon-512x512.png",
      "target": [
        "zip",
        "AppImage"
      ],
      "mimeTypes": [
        "video/mp4",
        "video/quicktime",
        "video/x-matroska",
        "video/x-msvideo",
        "video/mp2t",
        "video/webm",
        "video/x-m4v",
        "video/x-raw",
        "video/yuv"
      ],
      "artifactName": "VidPlot-Linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "VidPlot-Linux-${arch}.${ext}"
    },
    "afterPack": "electron/afterPack.js"
  }
}
